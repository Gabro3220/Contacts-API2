{
	"info": {
		"_postman_id": "contacts-api-advanced-collection",
		"name": "Contacts API - Advanced Features",
		"description": "Coleção completa para testar a API de Contatos com DTOs, Paginação, Bancos Relacionais e Swagger",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Exercícios Avançados",
			"item": [
				{
					"name": "Exercício 1 - DTOs",
					"item": [
						{
							"name": "Criar contato com DTO",
							"request": {
								"method": "POST",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"nome\": \"João Silva\",\n  \"telefone\": \"9999-9999\",\n  \"email\": \"joao@email.com\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/api/contacts",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"contacts"
									]
								},
								"description": "Cria um contato usando ContactRequest DTO"
							},
							"response": []
						},
						{
							"name": "Atualizar contato com DTO (PATCH)",
							"request": {
								"method": "PATCH",
								"header": [
									{
										"key": "Content-Type",
										"value": "application/json"
									}
								],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"email\": \"novoemail@email.com\"\n}",
									"options": {
										"raw": {
											"language": "json"
										}
									}
								},
								"url": {
									"raw": "{{base_url}}/api/contacts/{{contact_id}}",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"contacts",
										"{{contact_id}}"
									]
								},
								"description": "Atualiza contato usando ContactUpdateRequest DTO"
							},
							"response": []
						}
					]
				},
				{
					"name": "Exercício 3 - Paginação",
					"item": [
						{
							"name": "Listar contatos paginados",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/api/contacts/paginated?page=0&size=5&sort=nome&direction=ASC",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"contacts",
										"paginated"
									],
									"query": [
										{
											"key": "page",
											"value": "0",
											"description": "Número da página"
										},
										{
											"key": "size",
											"value": "5",
											"description": "Tamanho da página"
										},
										{
											"key": "sort",
											"value": "nome",
											"description": "Campo para ordenação"
										},
										{
											"key": "direction",
											"value": "ASC",
											"description": "Direção da ordenação"
										}
									]
								},
								"description": "Lista contatos com paginação e ordenação"
							},
							"response": []
						},
						{
							"name": "Buscar contatos paginados",
							"request": {
								"method": "GET",
								"header": [],
								"url": {
									"raw": "{{base_url}}/api/contacts/search/paginated?name=João&page=0&size=3&sort=nome&direction=ASC",
									"host": [
										"{{base_url}}"
									],
									"path": [
										"api",
										"contacts",
										"search",
										"paginated"
									],
									"query": [
										{
											"key": "name",
											"value": "João",
											"description": "Nome para buscar"
										},
										{
											"key": "page",
											"value": "0",
											"description": "Número da página"
										},
										{
											"key": "size",
											"value": "3",
											"description": "Tamanho da página"
										},
										{
											"key": "sort",
											"value": "nome",
											"description": "Campo para ordenação"
										},
										{
											"key": "direction",
											"value": "ASC",
											"description": "Direção da ordenação"
										}
									]
								},
								"description": "Busca contatos por nome com paginação"
							},
							"response": []
						}
					]
				}
			]
		},
		{
		"name": "2. Verificar MySQL",
		"item": [
			{
				"name": "Testar API com MySQL",
				"request": {
					"method": "GET",
					"header": [],
					"url": {
						"raw": "{{base_url}}/api/contacts",
						"host": [
							"{{base_url}}"
						],
						"path": [
							"api",
							"contacts"
						]
					},
					"description": "Testa API conectada ao MySQL"
				},
				"response": []
			}
		]
		},
		{
			"name": "3. Documentação Swagger",
			"item": [
				{
					"name": "Acessar Swagger UI",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/swagger-ui/index.html",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"swagger-ui",
								"index.html"
							]
						},
						"description": "Acessa a interface Swagger UI"
					},
					"response": []
				},
				{
					"name": "OpenAPI JSON",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/v3/api-docs",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"v3",
								"api-docs"
							]
						},
						"description": "Obtém a documentação OpenAPI em JSON"
					},
					"response": []
				}
			]
		},
		{
			"name": "4. Testes Completos",
			"item": [
				{
					"name": "Criar Contato",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 201) {",
									"    const response = pm.response.json();",
									"    pm.environment.set('contact_id', response.id);",
									"    console.log('Contact ID saved:', response.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"João Silva\",\n  \"telefone\": \"9999-9999\",\n  \"email\": \"joao@email.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/contacts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"contacts"
							]
						},
						"description": "Cria um contato para testes"
					},
					"response": []
				},
				{
					"name": "Listar Contatos Paginados",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/contacts/paginated?page=0&size=10&sort=nome&direction=ASC",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"contacts",
								"paginated"
							],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "sort",
									"value": "nome"
								},
								{
									"key": "direction",
									"value": "ASC"
								}
							]
						},
						"description": "Lista contatos com paginação"
					},
					"response": []
				},
				{
					"name": "Buscar Contatos Paginados",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/contacts/search/paginated?name=João&page=0&size=5&sort=nome&direction=ASC",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"contacts",
								"search",
								"paginated"
							],
							"query": [
								{
									"key": "name",
									"value": "João"
								},
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "5"
								},
								{
									"key": "sort",
									"value": "nome"
								},
								{
									"key": "direction",
									"value": "ASC"
								}
							]
						},
						"description": "Busca contatos por nome com paginação"
					},
					"response": []
				},
				{
					"name": "Atualizar Contato (PATCH)",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"novoemail@email.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/contacts/{{contact_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"contacts",
								"{{contact_id}}"
							]
						},
						"description": "Atualiza contato parcialmente"
					},
					"response": []
				},
				{
					"name": "Criar Endereço",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"rua\": \"Rua das Flores, 123\",\n  \"cidade\": \"São Paulo\",\n  \"estado\": \"SP\",\n  \"cep\": \"01234-567\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/addresses/contacts/{{contact_id}}",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"addresses",
								"contacts",
								"{{contact_id}}"
							]
						},
						"description": "Cria endereço para contato"
					},
					"response": []
				},
				{
					"name": "Testar Validação",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nome\": \"Maria\",\n  \"telefone\": \"123\",\n  \"email\": \"maria@email.com\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/contacts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"contacts"
							]
						},
						"description": "Testa validação com dados inválidos"
					},
					"response": []
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
